{
  "entities": {
    "projects": {
      "title": "Projects",
      "description": "Portfolio projects collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "liveUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "techStack": { "type": "array", "items": { "type": "string" } },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "description", "category"]
    },
    "personalInfo": {
      "title": "Personal Info",
      "description": "Portfolio owner info document",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "github": { "type": "string" },
        "linkedin": { "type": "string" },
        "twitter": { "type": "string" }
      }
    },
    "messages": {
      "title": "Contact Messages",
      "description": "Messages sent by visitors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "message"]
    },
    "integrations": {
      "title": "Integrations Config",
      "description": "Integrations configuration",
      "type": "object",
      "properties": {
        "githubToken": { "type": "string" },
        "vercelToken": { "type": "string" },
        "autoSync": { "type": "boolean" },
        "supabaseUrl": { "type": "string" },
        "supabaseKey": { "type": "string" }
      }
    },
    "system": {
      "title": "System Status",
      "description": "Initialization status doc",
      "type": "object",
      "properties": {
        "seeded": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "projects",
      "description": "Collection of developer portfolio projects"
    },
    "/personalInfo/{docId}": {
      "schema": "personalInfo",
      "description": "Developer personal information"
    },
    "/messages/{messageId}": {
      "schema": "messages",
      "description": "Contact form submissions"
    },
    "/integrations/{docId}": {
      "schema": "integrations",
      "description": "Integration tokens and configuration"
    },
    "/system/{docId}": {
      "schema": "system",
      "description": "System database initialization flag"
    }
  }
}
